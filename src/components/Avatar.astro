---
import { initials, isTBD } from '../lib/site';
interface Props { name: string; photo?: string; size?: string; }
const { name, photo, size } = Astro.props;
const style = size ? `width:${size};height:${size}` : undefined;
---
<div class="avatar" style={style}>
  {photo ? (
    <img src={photo} alt={`Photo of ${name}`} width="208" height="208" loading="lazy" decoding="async" />
  ) : isTBD(name) ? (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="8.5" r="4.2"/><path d="M3.5 21c.6-4.6 4.1-7.2 8.5-7.2s7.9 2.6 8.5 7.2z"/></svg>
  ) : (
    <span aria-hidden="true">{initials(name)}</span>
  )}
</div>

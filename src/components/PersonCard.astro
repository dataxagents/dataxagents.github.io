---
import Avatar from './Avatar.astro';
import { md, isTBD } from '../lib/site';
interface Props { person: any; }
const { person: p } = Astro.props;
const web = !isTBD(p.homepage) ? p.homepage : null;
const li = !isTBD(p.linkedin) ? p.linkedin : null;
---
<li class="person">
  <Avatar name={p.name} photo={p.photo} />
  <div>
    <div class="name">{web ? <a href={web} rel="noopener">{p.name}</a> : p.name}</div>
    <div class="meta">{p.title && <>{p.title}<br /></>}<span set:html={md(p.affiliation)} />{p.role && <><br /><span>{p.role}</span></>}</div>
    {(web || li) && (
      <div class="links">
        {web && <a href={web} rel="noopener">Website<span class="visually-hidden"> of {p.name}</span></a>}
        {web && li && <span class="sep" aria-hidden="true">·</span>}
        {li && <a href={li} rel="noopener">LinkedIn<span class="visually-hidden"> profile of {p.name}</span></a>}
      </div>
    )}
  </div>
</li>

---
import Base from '../layouts/Base.astro';
import { site, md } from '../lib/site';
---
<Base>
  <h1>Welcome</h1>
  {site.overview.map((p: string) => <p set:html={md(p)} />)}
  <p>See the <a href="/cfp/">Call for Papers</a> and the <a href="#dates">important dates</a>.</p>

  <h2>Who should attend</h2>
  <p set:html={md(site.audience)} />

  <h2>Open questions we want to discuss</h2>
  <ul>
    {site.open_questions.map((q: any) => (
      <li><strong>{q.label}:</strong> <span set:html={md(q.text)} /></li>
    ))}
  </ul>

  <h2>News</h2>
  {site.news?.length ? (
    <ul class="plain news">
      {site.news.map((n: any) => <li><span class="when" set:html={md(n.date)} /> <span set:html={md(n.text)} /></li>)}
    </ul>
  ) : <p class="muted">No news yet.</p>}
</Base>

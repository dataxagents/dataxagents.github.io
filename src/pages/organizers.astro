---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import { site } from '../lib/site';
const o = site.organizers;
---
<Base title="Organizers" description="Workshop chairs, steering committee, and program committee of DBxAgents @ SIGMOD/PODS 2027.">
  <h1>Organizers</h1>
  <p>To reach the organizers, please use the <a href="/contact/">shared contact address</a>.</p>

  <h2 id="chairs">Workshop Chairs</h2>
  <ul class="people">{o.chairs.map((p: any) => <PersonCard person={p} />)}</ul>

  <h2 id="steering">Steering Committee</h2>
  <ul class="people">{o.steering.map((p: any) => <PersonCard person={p} />)}</ul>

  <h2 id="pc">Program Committee</h2>
  {o.program_committee?.length ? (
    <ul class="pc-list">{o.program_committee.map((m: any) => <li>{m.name}{m.affiliation && <span class="muted">, {m.affiliation}</span>}</li>)}</ul>
  ) : <p class="muted">To be announced.</p>}
</Base>

---
import Base from '../layouts/Base.astro';
import { site, md, isTBD } from '../lib/site';
const typeLabel: Record<string, string> = { oral: 'Oral', poster: 'Poster', 'non-archival': 'Non-archival' };
const thrustTitle: Record<string, string> = Object.fromEntries(site.cfp.thrusts.map((t: any) => [t.id, t.title]));
---
<Base title="Accepted Papers" description="Accepted papers at DataxAgents @ SIGMOD/PODS 2027.">
  <h1>Accepted Papers</h1>
  {site.papers?.length ? (
    <ul class="plain papers">
      {site.papers.map((p: any) => (
        <li>
          <div class="ptitle">{!isTBD(p.pdf) ? <a href={p.pdf} rel="noopener">{p.title}</a> : p.title}</div>
          <div class="authors" set:html={md(p.authors)} />
          <div style="margin-top:0.35rem">
            {p.thrust && <span class="tag" title={thrustTitle[p.thrust]}>{p.thrust} · {thrustTitle[p.thrust]}</span>}
            {p.type && <span class="tag">{typeLabel[p.type] ?? p.type}</span>}
            {!isTBD(p.pdf) && <a href={p.pdf} rel="noopener" style="font-size:0.9rem">PDF</a>}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p>{site.papers_placeholder}</p>
  )}
</Base>

---
import Base from '../layouts/Base.astro';
import { site, md } from '../lib/site';
---
<Base title="Program" description="Tentative one-day program for DBxAgents @ SIGMOD/PODS 2027: keynotes, paper sessions by thrust, posters, and a panel.">
  <h1>Program</h1>
  <p set:html={md(site.program_intro)} />
  <p>The exact day is <span class="tbd">TBD</span>; workshops are held after the main conference (SIGMOD/PODS: {site.meta.conference_dates}).</p>
  <div class="table-wrap">
    <table class="program">
      <caption>{site.program_note}</caption>
      <thead>
        <tr><th scope="col">Time</th><th scope="col" class="min">Min</th><th scope="col">Session</th></tr>
      </thead>
      <tbody>
        {site.program.map((r: any) => (
          <tr class={r.kind}>
            <td class="time">{r.time}</td>
            <td class="min">{r.min}</td>
            <td><span class="session">{r.session}</span>{r.detail && <span class="detail" set:html={r.kind === 'panel' ? `: ${md(r.detail)}` : ` (${md(r.detail)})`} />}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p style="margin-top:1rem">Times are local (Pacific). See <a href="/speakers/">Speakers</a> for keynotes and the panel.</p>
</Base>

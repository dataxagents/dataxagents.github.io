---
import Base from '../layouts/Base.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import PersonCard from '../components/PersonCard.astro';
import { site, md } from '../lib/site';
const p = site.panel;
---
<Base title="Speakers" description="Keynote speakers and panel for DBxAgents @ SIGMOD/PODS 2027.">
  <h1>Speakers</h1>

  <h2 id="keynotes">Keynotes</h2>
  {site.keynotes.map((s: any) => <SpeakerCard speaker={s} />)}

  <h2 id="panel">Panel</h2>
  <p><strong>“{p.title}”</strong></p>
  <p set:html={md(p.description)} />
  <p><strong>Moderator:</strong> <span set:html={md(p.moderator)} /><br />
     <strong>Panelists:</strong> {p.panelists?.length ? null : <span class="tbd">TBD</span>}</p>
  {p.panelists?.length > 0 && <ul class="people">{p.panelists.map((x: any) => <PersonCard person={x} />)}</ul>}
</Base>
